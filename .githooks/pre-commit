#!/bin/sh
# Structure gate. Enable once per clone: git config core.hooksPath .githooks
node scripts/node/build-index.mjs --check || {
  echo "Fix the structure (run node scripts/node/build-index.mjs) before committing." >&2
  exit 1
}

# Publication evidence gate.
node scripts/node/publication-evidence-check.mjs || {
  echo "Publication invariants are broken; see the failures above." >&2
  exit 1
}

# Secret address gate (Mail2Blogger posting address must never be committed).
node scripts/node/secret-address-check.mjs || {
  echo "Redact the Mail2Blogger address in the files above before committing." >&2
  exit 1
}
